# Co-Intelligence automation — environment template. NO SECRETS IN THIS FILE.
# Copy to .env (git-ignored) or inject via your secret manager. Any variable may
# instead be supplied as NAME_FILE=/path/to/secret (Docker/K8s secrets).
#
# Fixed by code and NOT configurable: repo gabbyworkspace/Co-Intelligence,
# sender jarvis.resystem@gmail.com, final report to g@resystem.org, review package
# to baileys.resystem@gmail.com, timezone Asia/Dubai.
# Setting FINAL_REPORT_TO / FINAL_REPORT_FROM / REVIEW_PACKAGE_TO / GITHUB_OWNER / GITHUB_REPO to any
# other value makes the service refuse to start.

# --- REQUIRED: G's actual GitHub login (the repo owner is NOT assumed to be G)
FOUNDER_GITHUB_USERNAME=
# Optional but recommended: G's numeric GitHub user id (pins identity across renames)
FOUNDER_GITHUB_USER_ID=

# --- REQUIRED: trusted founder-decision channel = KITT's ChatGPT GPT Action.
# A GitHub OAuth App used ONLY by the KITT GPT Action (G signs in with GitHub inside
# ChatGPT). Without it, no founder decision is accepted (reported as a BLOCKER).
KITT_OAUTH_CLIENT_ID=
KITT_OAUTH_CLIENT_SECRET_FILE=/run/secrets/kitt_oauth_client_secret
# --- REQUIRED: trusted founder-decision channel for the FINAL review = JARVIS chat session.
# A separate GitHub OAuth App used ONLY by the JARVIS session integration. Without it,
# the final approval gate pauses (BLOCKER) — nothing is approved or closed.
JARVIS_OAUTH_CLIENT_ID=
JARVIS_OAUTH_CLIENT_SECRET_FILE=/run/secrets/jarvis_oauth_client_secret

# Public HTTPS base URL of this service (used in /kitt/openapi.json and /jarvis/openapi.json)
PUBLIC_BASE_URL=https://coint.example.com

# --- Storage
COINT_DB_PATH=/data/coint.sqlite3

# --- GitHub App (permissions: Issues RW, Contents RW, Pull requests R, Checks R, Metadata R)
# Webhook events: Issues, Issue comment, Pull request, Check run, Check suite
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key.pem
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
GITHUB_REPO_ID=
# Login of the App's bot user, e.g. co-intelligence[bot] (its comments are never parsed as commands)
GITHUB_APP_BOT_LOGIN=

# --- JARVIS Gmail (OAuth2, scope gmail.send + gmail.readonly for reconciliation)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET_FILE=/run/secrets/gmail_client_secret
GMAIL_REFRESH_TOKEN_FILE=/run/secrets/gmail_refresh_token

# --- Agent adapters: KIND = anthropic | openai_compat | http | manual | unsupported
# API keys are referenced by env-var NAME; the key itself is never in prompts or the repo.
ADAPTER_KITT_KIND=unsupported
ADAPTER_KITT_MODEL=
ADAPTER_KITT_API_KEY_ENV=ANTHROPIC_API_KEY
ADAPTER_KITT_GITHUB_LOGIN=
ADAPTER_KITT_MAX_RUNTIME_S=900
ADAPTER_KITT_MAX_OUTPUT_TOKENS=16000
ADAPTER_KITT_MAX_COST_USD=5
ADAPTER_KITT_PRICE_IN_PER_MTOK=
ADAPTER_KITT_PRICE_OUT_PER_MTOK=

ADAPTER_JARVIS_KIND=unsupported
ADAPTER_JARVIS_MODEL=
ADAPTER_JARVIS_API_KEY_ENV=ANTHROPIC_API_KEY
ADAPTER_JARVIS_GITHUB_LOGIN=
ADAPTER_JARVIS_MAX_COST_USD=10
ADAPTER_JARVIS_PRICE_IN_PER_MTOK=
ADAPTER_JARVIS_PRICE_OUT_PER_MTOK=

# GRONK example via xAI's OpenAI-compatible API
ADAPTER_GRONK_KIND=unsupported
ADAPTER_GRONK_ENDPOINT=https://api.x.ai/v1
ADAPTER_GRONK_MODEL=
ADAPTER_GRONK_API_KEY_ENV=XAI_API_KEY
ADAPTER_GRONK_GITHUB_LOGIN=
ADAPTER_GRONK_PRICE_IN_PER_MTOK=
ADAPTER_GRONK_PRICE_OUT_PER_MTOK=

# Four independent council reviewers (separately tracked calls)
ADAPTER_COUNCIL_1_KIND=unsupported
ADAPTER_COUNCIL_1_MODEL=
ADAPTER_COUNCIL_1_API_KEY_ENV=
ADAPTER_COUNCIL_1_ENDPOINT=
ADAPTER_COUNCIL_2_KIND=unsupported
ADAPTER_COUNCIL_2_MODEL=
ADAPTER_COUNCIL_2_API_KEY_ENV=
ADAPTER_COUNCIL_2_ENDPOINT=
ADAPTER_COUNCIL_3_KIND=unsupported
ADAPTER_COUNCIL_3_MODEL=
ADAPTER_COUNCIL_3_API_KEY_ENV=
ADAPTER_COUNCIL_3_ENDPOINT=
ADAPTER_COUNCIL_4_KIND=unsupported
ADAPTER_COUNCIL_4_MODEL=
ADAPTER_COUNCIL_4_API_KEY_ENV=
ADAPTER_COUNCIL_4_ENDPOINT=

# Provider keys (secret manager)
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# XAI_API_KEY_FILE=/run/secrets/xai_api_key

# --- Timing / limits
LEASE_SECONDS=300
HEARTBEAT_SECONDS=60
LEASE_GRACE_SECONDS=120
COUNCIL_REVIEW_TIMEOUT_MINUTES=60
STAGE_TIMEOUT_MINUTES=240
RETRY_DELAYS_MINUTES=1,5,15
MAX_REVISION_LOOPS=3
EMAIL_RECONCILE_WAIT_MINUTES=15
REQUIRE_CHECKS_PASS=true
